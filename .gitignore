# Built application files
*.apk
*.aab
*.ap_
*.dex

# Java/Kotlin class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and above
.externalNativeBuild/
.cxx/

# Google Services (if applicable)
# google-services.json

# Fabric plugin (if applicable)
# fabric.properties

# Trae AI workspace config
.trae/

# OS files
.DS_Store
Thumbs.db

# Uncertain files (architecture half-products, legacy code, etc.)
不确定是否上传这个文件/

# Screenshots and debug files
screenshots/

# Backup files
*.zip
*.bak

# Python cache (legacy scripts)
__pycache__/
*.pyc
