<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/alarm_trigger_background">

    <TextView
        android:id="@+id/alarmLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/alarm"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/background"/>

    <TextView
        android:id="@+id/alarmContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/notification_alarm_text"
        android:textSize="20sp"
        android:textColor="@color/alarm_text_secondary"
        android:layout_marginVertical="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnSnooze"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="6dp"
            android:background="@drawable/card_button_secondary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snooze"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDismiss"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="6dp"
            android:background="@drawable/card_button_secondary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dismiss"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
