<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingPetContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/pet_circle_background">

        <ImageView
            android:id="@+id/petImage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:src="@drawable/pet_happy"
            android:contentDescription="@string/content_desc_pet_floating"
            android:scaleType="centerCrop"/>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/pomodoroStatusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:padding="6dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pomodoroStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floating_pet_focusing"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/pomodoroTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pomodoro_default_time"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>

    </LinearLayout>

</LinearLayout>
